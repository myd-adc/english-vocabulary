# Copy to .env for local runs:  uvicorn app.main:app --env-file .env --reload
# On Render these are set in the dashboard (see README). NEVER commit the real .env.

# Postgres connection string. Supabase: Project -> Connect -> "Session pooler" string
# (IPv4, port 5432) and keep ?sslmode=require. Render cannot reach Supabase's direct
# (IPv6-only) host. URL-encode special characters in the password (@ -> %40, etc.).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Signing key for the Claude connector's access tokens (nobody types it). Long and random:
#   openssl rand -hex 32
MCP_SECRET=change-me-to-a-long-random-string

# Accounts come from Supabase Auth. The server only verifies the tokens.
SUPABASE_URL=https://zmzwuiokweedafgeacef.supabase.co
# Invite-only: comma-separated emails that may use the app (case-insensitive).
ALLOWED_EMAILS=you@example.com,friend@example.com
# Words saved before accounts existed are handed to this person on their first request.
OWNER_EMAIL=you@example.com
# Optional: HS256 secret (legacy Supabase projects). New projects need nothing here.
# SUPABASE_JWT_SECRET=

# Web app (read by Vite at build time; put them in web/.env.local for `npm run dev`).
# The anon / publishable key is public by design: it is safe in the browser bundle.
# VITE_SUPABASE_URL=https://zmzwuiokweedafgeacef.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Public https URL of the service, no trailing slash (OAuth metadata is built from it).
# Render: https://<service-name>.onrender.com   Local: http://localhost:8000
ISSUER_URL=http://localhost:8000

# Port to listen on (Render sets it automatically).
PORT=8000

# Optional: timezone used to decide what is "due today". Default Europe/Kyiv.
APP_TIMEZONE=Europe/Kyiv

# Optional: LLM for auto-translation and topics (any OpenAI-compatible API).
# Default is Google Gemini (free key: https://aistudio.google.com -> Get API key).
# Without LLM_API_KEY the app still works; translations are entered by hand.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-flash-lite-latest
# Optional backups, tried in order when the main LLM is rate-limited or down (LLM_2_ ... LLM_9_).
# A backup without its own key / base URL reuses the main one.
# LLM_2_MODEL=openai/gpt-oss-20b
# LLM_2_API_KEY=
# LLM_2_BASE_URL=
# LLM_2_REASONING_EFFORT=low
